	keywords = {62F15, Sparsity, horseshoe, 62G15, adaptive inference, frequentist Bayes, nearly black vectors, normal means problem},
	pages = {3196--3225},
	file = {Full Text PDF:C\:\\Users\\ArnoldSeong\\Zotero\\storage\\WAI9WMVE\\Pas et al. - 2017 - Adaptive posterior contraction rates for the horseshoe.pdf:application/pdf},
