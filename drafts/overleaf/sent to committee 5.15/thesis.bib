	file = {Full Text PDF:C\:\\Users\\ArnoldSeong\\Zotero\\storage\\QW7WKA78\\Vasudevan et al. - 2021 - Off-the-shelf deep learning is not enough, and requires parsimony, Bayesianity, and causality.pdf:application/pdf},
