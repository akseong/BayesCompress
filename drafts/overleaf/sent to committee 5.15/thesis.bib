}

@inproceedings{liu_variable_2021,
	title = {Variable {Selection} with {Rigorous} {Uncertainty} {Quantification} using {Deep} {Bayesian} {Neural} {Networks}: {Posterior} {Concentration} and {Bernstein}-von {Mises} {Phenomenon}},
	issn = {2640-3498},
